---
import { type CollectionEntry, render } from 'astro:content';
import BlogPostLayout from '@/layouts/blog-post.astro';
import { getPosts } from '@/lib/fetchers';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    // posts are newest first, so the next entry is the previous post
    props: { post, previous: posts[i + 1] }
  }));
}

type Props = {
  post: CollectionEntry<'blog'>;
  previous?: CollectionEntry<'blog'>;
};

const { post, previous } = Astro.props;
const { Content } = await render(post);
---

<BlogPostLayout post={post} previous={previous}>
  <Content />
</BlogPostLayout>
