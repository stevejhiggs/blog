---
import PostRow from '@/components/post-row.astro';
import MainLayout from '@/layouts/main-layout.astro';
import { getPosts } from '@/lib/fetchers';
import { formatDate } from '@/lib/utils';

const latest = (await getPosts()).slice(0, 3);
const inlineLink = 'underline decoration-brand decoration-2 underline-offset-4';
---

<MainLayout title="Home" description="Steve Higgs, fullstack developer">
  <div class="mx-auto max-w-[760px] px-6 pt-14 pb-20 md:pt-20">
    <section>
      <h1 class="font-heading text-[clamp(36px,5vw,48px)] leading-tight font-bold tracking-[-0.03em]">
        Steve Higgs
      </h1>
      <p class="mt-1 text-lg text-muted-foreground">Fullstack developer</p>

      <div class="mt-8 space-y-4 text-lg leading-relaxed">
        <p>
          Starting with C++ I've wended a road through ASP, C# and Java. I now mostly spend my time in
          JavaScript, using Node for the backend and various frontend frameworks
          <span class="text-muted-foreground">(and Bun when I can get away with it).</span>
        </p>
        <p>
          Currently hacking away on
          <a href="https://videofn.com/" class={inlineLink}>videoFn</a>
          in my spare time.
        </p>
      </div>
    </section>

    <section aria-labelledby="latest" class="mt-16">
      <h2 id="latest" class="text-sm font-semibold text-muted-foreground">Latest</h2>
      <ul class="mt-3 divide-y border-y">
        {latest.map((post) => <PostRow post={post} meta={formatDate(post.data.pubDate)} />)}
      </ul>
    </section>
  </div>
</MainLayout>
