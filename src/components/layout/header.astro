---
import { siteConfig } from '@/config/site';
import { cn } from '@/lib/utils';

const onWriting = Astro.url.pathname.startsWith('/blog');
const linkClass = 'block px-3.5 py-3 no-underline';
---

<header class="border-b">
  <div class="mx-auto flex max-w-[760px] flex-wrap items-center justify-between gap-x-6 px-6 py-2">
    <a href="/" class="py-3 font-mono font-medium no-underline">
      shiggs<span class="text-brand">AtWork</span>
    </a>
    <nav aria-label="Main">
      <ul class="-mr-3.5 flex flex-wrap gap-1 text-[15px] font-medium">
        <li>
          <a
            href="/blog/"
            aria-current={onWriting ? 'page' : undefined}
            class={cn(linkClass, onWriting && 'underline decoration-brand decoration-2 underline-offset-[6px]')}
          >
            Writing
          </a>
        </li>
        <li><a href={siteConfig.links.github} class={linkClass}>GitHub</a></li>
        <li><a href="/rss.xml" class={linkClass}>RSS</a></li>
      </ul>
    </nav>
  </div>
</header>
