---
import Header from '@/components/layout/header.astro';
import { cn } from '@/lib/utils';
import BaseLayout from './base-layout.astro';

type Props = {
  title: string;
  seoTitle?: string;
  description?: string;
  mainClass?: string;
  ogType?: 'website' | 'article';
};

const { title, seoTitle, description, mainClass, ogType } = Astro.props;
---

<BaseLayout title={title} seoTitle={seoTitle} description={description} ogType={ogType}>
  <slot name="head" slot="head" />
  <Header />

  <main class={cn('flex-1', mainClass)}>
    <slot />
  </main>
</BaseLayout>
