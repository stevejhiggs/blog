---
import type { CollectionEntry } from 'astro:content';
import { siteConfig } from '@/config/site';
import { categoryHref } from '@/lib/fetchers';
import { formatDate } from '@/lib/utils';
import MainLayout from './main-layout.astro';

type Props = {
  post: CollectionEntry<'blog'>;
  previous?: CollectionEntry<'blog'>;
};

const { post, previous } = Astro.props;
const { title, seoTitle, description, pubDate, updatedDate, category, cover } = post.data;

const url = new URL(Astro.url.pathname, Astro.site).href;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  image: new URL(cover, Astro.site).href,
  datePublished: pubDate.toISOString(),
  dateModified: (updatedDate ?? pubDate).toISOString(),
  articleSection: category,
  url,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  author: { '@type': 'Person', name: 'Steve Higgs', url: siteConfig.url },
  publisher: { '@type': 'Person', name: 'Steve Higgs', url: siteConfig.url }
};
---

<MainLayout title={title} seoTitle={seoTitle} description={description} ogType="article">
  <script slot="head" type="application/ld+json" is:inline set:html={JSON.stringify(articleSchema)} />
  <div class="mx-auto max-w-[760px] px-6 pt-14 pb-20 md:pt-20">
    <p class="text-sm text-muted-foreground">
      {formatDate(pubDate)}
      {updatedDate && <> · updated {formatDate(updatedDate)}</>}
      {' · '}
      <a href={categoryHref(category)} class="no-underline">{category}</a>
    </p>
    <h1 class="mt-3 font-heading text-[clamp(30px,4vw,40px)] leading-tight font-bold tracking-[-0.025em]">
      {title}
    </h1>
    {description && <p class="mt-4 text-lg leading-relaxed text-muted-foreground">{description}</p>}

    <article
      class="prose mt-10 max-w-none md:prose-lg prose-headings:font-heading prose-headings:font-bold prose-headings:tracking-[-0.02em] prose-a:decoration-brand prose-a:decoration-2 prose-a:underline-offset-[3px] prose-code:font-normal prose-code:before:content-none prose-code:after:content-none prose-pre:rounded-lg prose-pre:font-mono prose-pre:text-sm"
    >
      <slot />
    </article>

    {
      previous && (
        <a href={`/blog/${previous.id}/`} class="mt-16 block border-t pt-5 no-underline">
          <span class="block text-sm text-muted-foreground">Previous</span>
          <span class="mt-1 block font-heading text-lg leading-snug font-semibold">{previous.data.title}</span>
        </a>
      )
    }
  </div>
</MainLayout>
